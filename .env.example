# Names the app reads with process.env. No values.
# Copy to .env locally. Do not commit .env.
#
# NODE_ENV is set by Next.js (development, production, or test).
# In production the hyto_sesion cookie is Secure.
# VERCEL_ENV=production also blocks the unsigned-JWT shortcut.

# Public. Shipped to the browser. Cavos app id, not a secret.
# Without it, the client does not call Cavos.
NEXT_PUBLIC_CAVOS_APP_ID=

# Server. Required to pay. Without it, signing returns 503.
TRUSTLESS_API_KEY=

# Server. HMAC secret for prepare/submit. At least 32 characters.
# In production, prepare and submit return 503 without it.
# Outside production, if this is unset, HYTO_TEST_SESSION_KEY is the fallback.
HYTO_TOKEN_SECRET=

# Server. Test-only fallback for HYTO_TOKEN_SECRET. Do not set this in production.
HYTO_TEST_SESSION_KEY=

# Server. Three distinct G… accounts, also distinct from the organizer and the receiver.
# Without them, deploy returns 503. Platform fee in Hyto is 0.
HYTO_ESCROW_PLATFORM=
HYTO_ESCROW_RESOLVER=
HYTO_ESCROW_ADMIN=

# Server. Separate key for the v1 retry in npm run hito. Must differ from TRUSTLESS_API_KEY.
TRUSTLESS_API_KEY_V1=

# Server. Neon or local Postgres. Without it, routes say the database is not configured.
DATABASE_URL=

# Server. Production database host, or several separated by commas.
# db:migrar and db:semilla compare this with the host in DATABASE_URL.
HYTO_HOST_BASE_PRODUCCION=

# Server. Only the value si allows migrate or seed when DATABASE_URL points at a production host.
# Leave empty in this example.
HYTO_CONFIRMAR_BASE_PRODUCCION=

# Server. Private Vercel Blob. Without it, photo upload and read return 503.
BLOB_READ_WRITE_TOKEN=

# Server. Groq. Optional. Without it, review is stored as an error (origen "error").
GROQ_API_KEY=

# Server. Optional. Groq vision model. Unset uses qwen/qwen3.8-27b.
GROQ_VISION_MODEL=

# Server. Optional. Gemini vision fallback when Groq fails. Without it, review stays on Groq.
GEMINI_API_KEY=

# Server. Optional. Gemini vision model. Unset uses gemini-flash-lite-latest.
GEMINI_VISION_MODEL=

# Server. Laya base URL. Optional. Without it, review uses the stub outside production.
# In production a missing LAYA_URL is stored as an error and does not approve the evidence.
LAYA_URL=

# Server. Optional. Sent to Laya as Bearer when set.
LAYA_API_KEY=

# Server. JWKS URL for the Cavos JWT. Without CAVOS_JWT_JWK and without this URL there is no session
# (unless the non-production unsigned shortcut is on).
CAVOS_JWKS_URL=

# Server. Allowed iss values, comma-separated. Empty: issuer is not checked.
CAVOS_JWT_ISSUER=

# Server. When set, aud must match. Empty: audience is not checked.
CAVOS_JWT_AUDIENCE=

# Server. Public JWK. Wins over CAVOS_JWKS_URL. No private key.
CAVOS_JWT_JWK=

# Development only. Exact value 1. Ignored when NODE_ENV or VERCEL_ENV is production.
HYTO_PERMITIR_JWT_SIN_FIRMA=

# Server. Exact value 1 enables demo login. Any other value makes POST /api/sesion/demo return 404.
# Demo sessions cannot sign or create events.
HYTO_DEMO_LOGIN=

# Server. Optional. Exact value on asks Mile to score each stored photo requirement.
# Unset or off keeps the current review. Do not turn this on until migration 0007 is applied.
# HYTO_MILE_REQUISITOS=off

# Server. Optional. Photos Mile may send back before the organizer decides. Unset means 3.
# HYTO_MILE_INTENTOS=3

# Server. Optional. Exact value on turns on communities. Unset keeps today's app.
# Do not turn this on until drizzle/0010_comunidades.sql is applied.
# HYTO_COMUNIDADES=off

# Server. Optional. Exact value on turns on the community bulletin.
# Also needs HYTO_COMUNIDADES=on. Do not turn this on until
# drizzle/0010_comunidades.sql and drizzle/0013_tablon.sql are applied.
# HYTO_TABLON=off

# Server. Optional. public or mainnet points the USDC balance read at public Horizon.
# Unset means testnet. This does not move the Trustless escrow API off testnet.
HYTO_STELLAR_NETWORK=

# Integration tests only. Not read by the app.
# HYTO_PROBE_URL=
