# Lo publica Sebas. Sin este valor las pantallas del integrante siguen
# con los ejemplos; las cuatro cuentas esperan el identificador.
NEXT_PUBLIC_CAVOS_APP_ID=

# Servidor. La pone Sebas en Vercel. No va al navegador.
# El script del hito y /api/firma la leen. Sin ella no hay pago.
TRUSTLESS_API_KEY=

# Servidor. Neon. La pone Esteban en Vercel. No va al navegador.
DATABASE_URL=

# Servidor. Vercel Blob, almacén privado. La pone Esteban. No va al navegador.
BLOB_READ_WRITE_TOKEN=

# Servidor. Llama 4 Scout en Groq. La pone Esteban. Sin ella, la revisión usa el guion fijo.
GROQ_API_KEY=

# Servidor. URL pública de Laya. La publica Abdiel. Sin ella, la revisión usa el stub.
LAYA_URL=

# Servidor, opcional. Si existe, la revisión la manda a Laya. Pendiente de acordar con Abdiel.
LAYA_API_KEY=

# Pendiente de confirmar con Cavos. La doc oficial no publica JWKS, emisor,
# audience ni un endpoint para verificar el JWT en el servidor.
# Sin CAVOS_JWT_JWK y sin esta URL, POST /api/sesion no abre sesión.
# Varias URLs https separadas por coma, en el mismo orden que CAVOS_JWT_ISSUER
# cuando hay más de una. Una sola URL se usa con el único emisor, si hay uno.
CAVOS_JWKS_URL=

# Pendiente de confirmar con Cavos. Lista separada por coma.
# El OTP de Cavos y el ingreso con Google traen emisores distintos.
# Vacío: no se comprueba el emisor.
CAVOS_JWT_ISSUER=

# Pendiente de confirmar con Cavos. Lista separada por coma.
# Si está, el aud del JWT tiene que coincidir con uno de ellos.
# Vacío: no se comprueba la audiencia.
CAVOS_JWT_AUDIENCE=

# Pendiente de confirmar con Cavos. JWK público (JSON), {"keys":[...]},
# o {"https://emisor": JWK | {"keys":[...]}}. Sin la parte privada.
# Cada JWK puede incluir "iss" para usarse solo con ese emisor.
# Si está, se verifica la firma RS256 y el vencimiento.
# Si el token trae kid, la clave de ese emisor tiene que traer el mismo.
CAVOS_JWT_JWK=
