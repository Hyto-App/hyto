# Lo publica Sebas. Sin este valor las pantallas del integrante siguen
# con los ejemplos; las cuatro cuentas esperan el identificador.
NEXT_PUBLIC_CAVOS_APP_ID=

# Servidor. La pone Sebas en Vercel. No va al navegador.
# El script del hito y /api/firma la leen. Sin ella no hay pago.
TRUSTLESS_API_KEY=

# Servidor. Neon. La pone Esteban en Vercel. No va al navegador.
DATABASE_URL=

# Servidor. Vercel Blob, almacén privado. La pone Esteban. No va al navegador.
BLOB_READ_WRITE_TOKEN=

# Servidor. Llama 4 Scout en Groq. La pone Esteban. Sin ella, la revisión usa el guion fijo.
GROQ_API_KEY=

# Servidor. URL pública de Laya. La publica Abdiel. Sin ella, la revisión usa el stub.
LAYA_URL=

# Servidor, opcional. Si existe, la revisión la manda a Laya. Pendiente de acordar con Abdiel.
LAYA_API_KEY=

# Servidor, opcional. JWKS del JWT que Cavos firma para el código de correo.
# Vacío: https://cavos.xyz/.well-known/jwks.json
CAVOS_JWKS_URL=

# Servidor, opcional. Emisor (`iss`) de ese JWT.
# Vacío: https://cavos.app/firebase (el que reconoce @cavos/kit 0.2.5).
CAVOS_JWT_ISSUER=

# Servidor, opcional. Audience (`aud`) del JWT de Cavos. Cavos no la publica.
# Sin este valor no se comprueba aud.
CAVOS_JWT_AUDIENCE=

# Servidor, opcional. JWK público (JSON) o un JWKS `{"keys":[...]}`.
# Si está, no se consulta CAVOS_JWKS_URL. Sin la parte privada (`d`).
# Si el token trae `kid`, la clave tiene que traer el mismo.
CAVOS_JWT_JWK=

# Servidor. Client ID de Google: es el `aud` del id_token de Entrar con Google.
# Sin este valor ese ingreso no abre sesión. El valor no está en el repositorio.
CAVOS_GOOGLE_CLIENT_ID=

# Servidor, opcional. JWKS de Google.
# Vacío: https://www.googleapis.com/oauth2/v3/certs
CAVOS_GOOGLE_JWKS_URL=

# Servidor. Project ID de Firebase, para el magic link
# (`iss` y `aud` = https://securetoken.google.com/<id> y el id).
# Entrar usa código y Google, no el magic link. Sin este valor ese token no abre sesión.
CAVOS_FIREBASE_PROJECT_ID=

# Servidor, opcional. JWKS de Firebase.
# Vacío: https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
CAVOS_FIREBASE_JWKS_URL=
