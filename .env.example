# Variables que el código lee con process.env. Sin valores.
# Copiala a .env en local. No subas .env: está en .gitignore.
#
# NODE_ENV no se declara acá. La define Next.js (development, production o test).
# lib/sesion/cookie.ts:9 la lee. En production la cookie hyto_sesion lleva Secure.
# Si no es production, la cookie sale sin Secure.

# Pública. Va al navegador: la leen componentes de cliente.
# Es el identificador de la app de Cavos, no una clave.
# lib/integrante/identidades.ts:20 (appIdPublico).
# Sin valor, o solo espacios: no se llama a Cavos.
# Entrar avisa "El ingreso espera el identificador de Cavos."
# Preparar cuentas avisa "Las cuentas esperan el identificador de Cavos."
NEXT_PUBLIC_CAVOS_APP_ID=

# Servidor. No va al navegador. Obligatoria para pagar.
# lib/escrow/modulo.ts:41 (POST /api/firma y POST /api/firma/enviar)
# y scripts/hito-prueba.ts:30.
# Sin ella, la API responde 503: "Falta la clave de Trustless Work en el servidor."
# El script del hito sale con código 2 y no despliega ni libera.
TRUSTLESS_API_KEY=

# Servidor. No va al navegador. Tres cuentas G distintas entre sí,
# y distintas del organizador y de quien cobra.
# lib/escrow/desplegar.ts. Sin ellas, desplegar responde 503.
# HYTO_ESCROW_PLATFORM cobra la comisión (en Hyto es 0).
# HYTO_ESCROW_RESOLVER resuelve disputas.
# HYTO_ESCROW_ADMIN no puede repetir ningún otro rol, incluida la plataforma.
HYTO_ESCROW_PLATFORM=
HYTO_ESCROW_RESOLVER=
HYTO_ESCROW_ADMIN=

# Servidor. No va al navegador. Solo para repetir el hito en v1.
# lib/escrow/cuerpos.ts (claveDeV1) y scripts/hito-prueba.ts.
# Tiene que ser distinta de TRUSTLESS_API_KEY.
# Sin ella, el reintento en v1 no corre.
TRUSTLESS_API_KEY_V1=

# Servidor. Neon. No va al navegador. Obligatoria para la base.
# lib/db/neon.ts:136, scripts/migrar.ts:5, scripts/semilla.ts:4
# y drizzle.config.ts.
# Sin ella, las rutas responden 503: "La base no está configurada."
# npm run db:migrar y npm run db:semilla salen con código 1.
# drizzle-kit se niega si la URL falta o la salvaguarda no está ok.
DATABASE_URL=

# Servidor. Hostname de la base de producción, o varios separados por coma.
# lib/config/entorno.ts. db:migrar y db:semilla lo comparan con el host de DATABASE_URL.
# Sin él avisan y siguen: no se puede saber si esa URL es de producción.
# Si algún host no se puede leer, no migran ni siembran. No pongas un host real.
HYTO_HOST_BASE_PRODUCCION=

# Servidor. Confirmación para migrar o sembrar cuando DATABASE_URL apunta
# a un host de HYTO_HOST_BASE_PRODUCCION. El único valor que habilita es si.
# Dejala vacía: no confirmes producción en el ejemplo.
HYTO_CONFIRMAR_BASE_PRODUCCION=

# Servidor. Vercel Blob, almacén privado. No va al navegador.
# Obligatoria para guardar y leer fotos. lib/blob/fotos.ts:31.
# Sin ella, fotosBlob() devuelve null.
# Subir una evidencia y leer su foto responden 503:
# "El almacén de fotos no está configurado."
BLOB_READ_WRITE_TOKEN=

# Servidor. Groq. No va al navegador. Opcional.
# lib/revision/revisar.ts:33.
# Without it, or if Groq fails, the review stores the error and does not use the fixed script.
GROQ_API_KEY=

# Servidor. URL de Laya. No va al navegador. Opcional.
# lib/revision/revisar.ts:34.
# Without it, after Groq the review uses the Laya stub and marks the verdict as stub.
LAYA_URL=

# Servidor. Opcional. No va al navegador.
# lib/revision/laya.ts:97.
# Si tiene valor, la revisión la manda a Laya como Bearer.
# Si falta, Laya se llama igual, sin esa cabecera.
LAYA_API_KEY=

# Servidor. No va al navegador. Una o varias URLs https, separadas por coma.
# lib/sesion/jwt.ts. Si hay tantas URLs como emisores en CAVOS_JWT_ISSUER,
# cada URL verifica solo a su emisor, en el mismo orden. El token usa la clave
# de ese emisor cuyo kid coincide. Sin CAVOS_JWT_JWK y sin esta URL no hay sesión.
# Una respuesta 200 con keys vacías no se cachea.
CAVOS_JWKS_URL=

# Servidor. Lista de iss permitidos, separados por coma.
# El código de Cavos y Google traen emisores distintos
# (https://cavos.app/firebase y https://accounts.google.com).
# Vacío: no se comprueba el emisor. Con verificación activa, hay que listar
# los dos si se usan los dos ingresos.
CAVOS_JWT_ISSUER=

# Servidor. Si está, el aud del JWT tiene que coincidir.
# Vacío: no se comprueba la audiencia.
CAVOS_JWT_AUDIENCE=

# Servidor. JWK público, {"keys":[...]} o {"https://emisor": JWK}.
# Sin la parte privada. Si está, se verifica la firma RS256 y el vencimiento.
# Una clave con iss, o una entrada del objeto por emisor, solo vale para ese iss.
# Dentro de ese emisor, el kid elige la clave. Tiene prioridad sobre CAVOS_JWKS_URL.
CAVOS_JWT_JWK=

# Solo desarrollo. Valor exacto: 1.
# Sin CAVOS_JWT_JWK ni CAVOS_JWKS_URL, lee el JWT sin comprobar la firma.
# NODE_ENV=production o VERCEL_ENV=production lo ignoran siempre.
HYTO_PERMITIR_JWT_SIN_FIRMA=

# Servidor. Valor exacto: 1. No va al navegador.
# app/api/sesion/demo/route.ts y lib/sesion/demo.ts.
# Con 1, el ingreso muestra "Entrar como demo" y POST /api/sesion/demo
# abre sesión de organizador o voluntario sin Cavos.
# Cualquier otro valor, o vacío, apaga la ruta: POST responde 404.
# Esa sesión no tiene billetera y /api/firma* responde 403.
HYTO_DEMO_LOGIN=
